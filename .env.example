# Copia este archivo a .env y rellena con valores reales (nunca subir .env a git)

# Credenciales del panel de administración (icono engranaje en la navbar)
REACT_APP_ADMIN_USER=admin
REACT_APP_ADMIN_PASS=cambia_esto

# Google Maps Embed API key (restringida por referrer HTTP en Google Cloud Console)
REACT_APP_GOOGLE_MAPS_KEY=tu_google_maps_api_key_aqui
